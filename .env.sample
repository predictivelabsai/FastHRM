# --- FastHR ----------------------------------------------------------------
FASTHR_ADMIN_EMAIL=admin@fasthr.example
FASTHR_ADMIN_PASSWORD=FastHR2026$
FASTHR_SECRET=
FASTHR_PORT=5010
FASTHR_ENV_LABEL=FastHR
FASTHR_DB=
FASTHR_UPLOAD_DIR=
# Optional bearer token used by the sourcing-extension intake endpoint.
FASTHR_SOURCE_TOKEN=
# Shared HMAC-SHA256 secret for email/SMS delivery event webhooks.
FASTHR_COMMUNICATION_WEBHOOK_SECRET=
# Shared HMAC-SHA256 secret for inbound job-board applicant webhooks.
FASTHR_JOB_BOARD_WEBHOOK_SECRET=
# Base URL for generated live-video rooms (defaults to https://meet.jit.si).
FASTHR_VIDEO_BASE_URL=https://meet.jit.si

# --- AI assistant ----------------------------------------------------------
# MODEL_PROVIDER: xai | openai | anthropic | google. Slash-commands need no key.
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hrm.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# Enterprise SAML/OIDC verification adapter as importable "module:factory".
# The adapter must validate signatures, issuer, audience, nonce/state, and expiry.
FASTHR_SSO_VERIFIER=
# Optional "module:factory" callable for video transcription and summarisation.
FASTHR_TRANSCRIBER=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://hrm.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=
